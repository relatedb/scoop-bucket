{
    "version": "1.3.0",
    "description": "Relate: embedded openCypher graph database with a single-binary CLI",
    "homepage": "https://relatedb.ai",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/relatedb/relate/releases/download/v1.3.0/relate-windows-amd64.exe",
            "hash": "sha256:9d887ffdb412d8b411bad53c5dc91337f1a4e7ff3769837a51b5bcb46f1c99b5"
        }
    },
    "bin": [
        [
            "relate-windows-amd64.exe",
            "relate"
        ]
    ],
    "post_install": "[IO.File]::WriteAllText((Join-Path $dir '.relate-package-managed'), '{\"manager\":\"scoop\",\"upgrade\":\"scoop update relate\"}')",
    "checkver": {
        "url": "https://relatedb.ai/releases.json",
        "jsonpath": "$.latest.tag",
        "regex": "v(\\d+\\.\\d+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/relatedb/relate/releases/download/v$version/relate-windows-amd64.exe",
                "hash": {
                    "url": "$baseurl/assets.json",
                    "jsonpath": "$['relate-windows-amd64.exe'].sha256"
                }
            }
        }
    }
}
